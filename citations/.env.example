# Copy this file to .env and fill in. .env is gitignored.

# Get one at https://openalex.org -> "Get an API key" (free).
# Required since 2026-02-13 for the polite pool.
OPENALEX_API_KEY=

# Your email; sent as the User-Agent contact and as mailto= on each request.
# OpenAlex uses this to reach out if our traffic ever causes issues.
OPENALEX_MAILTO=
